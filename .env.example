APP_NAME="EVE Diagnostics Booking API"
APP_VERSION="0.1.0"
ENVIRONMENT=development
DEBUG=true

DATABASE_URL="postgresql+asyncpg://eve:eve@localhost:5432/eve_diagnostics"
TEST_DATABASE_URL="sqlite+aiosqlite:///./test.db"

JWT_SECRET_KEY="change-me-in-production-use-a-long-random-value"
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

WEBHOOK_SIGNING_SECRET="mockpay-webhook-secret"
WEBHOOK_REQUIRE_SIGNATURE=false

REDIS_URL="redis://localhost:6379/0"
CACHE_TTL_SECONDS=60

RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60

LOG_LEVEL=INFO
LOG_JSON=true

SEED_ADMIN_EMAIL="admin@eve.health"
SEED_ADMIN_PASSWORD="Admin@12345"
