APP_NAME="EVE Diagnostics Booking API"
APP_VERSION="0.1.0"
ENVIRONMENT=development
DEBUG=false
# Comma-separated. Empty denies all cross-origin requests, which is the right
# default outside development. Never leave this as "*" in production.
CORS_ORIGINS=""

DATABASE_URL="postgresql+asyncpg://eve:eve@localhost:5432/eve_diagnostics"
# TEST_DATABASE_URL is a real environment variable, not a .env key: the test
# suite reads os.environ directly. Set it on the command line, e.g.
#   TEST_DATABASE_URL=postgresql+asyncpg://... make test-postgres

JWT_SECRET_KEY="change-me-in-production-use-a-long-random-value"
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

WEBHOOK_SIGNING_SECRET="mockpay-webhook-secret"
# The receiver is unauthenticated, so signatures are required by default. Set
# this to false only for local experiments with the bundled curl examples.
WEBHOOK_REQUIRE_SIGNATURE=true

REDIS_URL="redis://localhost:6379/0"
CACHE_TTL_SECONDS=60

RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60
# Only enable behind a proxy that overwrites X-Forwarded-For; otherwise clients
# can rotate the header to sidestep the limiter.
RATE_LIMIT_TRUST_PROXY_HEADERS=false

LOG_LEVEL=INFO
LOG_JSON=true

SEED_ADMIN_EMAIL="admin@eve.health"
SEED_ADMIN_PASSWORD="Admin@12345"
